#modo 'a' vem de append (anexar/ adicionar)
# ele coloca o cursor direto no final do texto que ja existe 
with open("meu_primeiro_arquivo.txt","a") as arquivo:
 arquivo.write("\n essa parte do texto foi adicionada depois")

"""open('nome','modo') abre o arquivo
read() le todo o conteudo como uma grande string
readline() le somente uma linha por vez
readlines() le o arquivo e transforma cada um em um item de lista
write("texto") escreve o texto no arquivo
close() fecha o arquivo e libera memoria
seel(0) volta aler o codigo do começo"""

# estrutura: with open(nome, modo) as alias:

with open("lista_compras.txt", "w") as f:
 f.write("pao\nleite\ncafe")
